# Copy to .env and fill in. Every process of the deployment reads the same file.

# Database password used by docker-compose for its postgres service. Outside
# compose, set DUEBOOK_DATABASE_URL instead.
POSTGRES_PASSWORD=change-me
# DUEBOOK_DATABASE_URL=postgresql://duebook:change-me@localhost:5432/duebook

# The model that reads ticket messages (any OpenAI-compatible endpoint).
DUEBOOK_OPENROUTER_API_KEY=
DUEBOOK_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DUEBOOK_OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Second opinion on proposals to close, cancel or replace a commitment.
DUEBOOK_VERIFIER_ENABLED=true
DUEBOOK_VERIFIER_MODEL=deepseek/deepseek-v4.1-flash
DUEBOOK_VERIFIER_REASONING=low

# POST /events requires X-Duebook-Signature: sha256=<hmac of the raw body> when set.
DUEBOOK_WEBHOOK_SECRET=
# Read endpoints require Authorization: Bearer <key> when set.
DUEBOOK_API_KEY=

# Where alerts go: "log" (JSON lines on stdout) or "webhook".
DUEBOOK_ALERT_CHANNEL=log
DUEBOOK_ALERT_URL=
# Signs outgoing alert webhooks with the same scheme; empty sends them unsigned.
DUEBOOK_ALERT_SECRET=

# The working calendar: "by Friday" means the end of Friday in this zone.
# Must stay the same for the lifetime of the data: cards are replayed under it.
DUEBOOK_TIMEZONE=Europe/Moscow
# No alert for a deadline before this moment. Set it to go-live when importing
# old tickets, or every long-broken promise is alerted at once.
DUEBOOK_ALERTS_SINCE=

# Optional tuning.
# DUEBOOK_WORKER_NAME=
# DUEBOOK_PROCESS_IDLE_SECONDS=1
# DUEBOOK_PROCESS_BATCH=20
# DUEBOOK_EXTRACTION_BATCH_TIMEOUT_SECONDS=10  # zero reads queued messages individually
# DUEBOOK_SCHEDULE_MAX_IDLE_SECONDS=30
# DUEBOOK_DELIVER_IDLE_SECONDS=5
# DUEBOOK_DELIVER_BATCH=10
# DUEBOOK_PORT=8000
# DUEBOOK_POOL_MIN=1
# DUEBOOK_POOL_MAX=10
